# Django
# Produksi: DJANGO_SETTINGS_MODULE=config.settings.production, DJANGO_DEBUG=false,
# dan DJANGO_SECRET_KEY WAJIB diisi (aplikasi gagal start bila kosong).
# Buat: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Hanya config.settings.production (semua opsional, default aman)
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_LOG_LEVEL=INFO

# Lockout login (per username+IP)
# PCC_LOGIN_MAX_FAILURES=5
# PCC_LOGIN_LOCKOUT_SECONDS=600

# Docker compose
# POSTGRES_PASSWORD=ganti-ini

# Database (kosong = SQLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/pcc

# Microsoft Entra ID SSO
# Buat app registration: redirect URI http://localhost:8000/auth/callback/
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Progress variance thresholds (percentage points)
PCC_AT_RISK_THRESHOLD=-1
PCC_DELAYED_THRESHOLD=-5

# Internal snapshot scheduler (H6). Default off.
# Nyalakan hanya jika tidak memakai systemd timer/cron eksternal.
SCOPE_SCHEDULER_ENABLED=false
SCOPE_SCHEDULER_INTERVAL_MINUTES=60

# Email (lihat docs/deployment.md)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL="Scope <no-reply@example.com>"
# SITE_URL=https://scope.example.com

# Integrasi Microsoft Teams & Outlook (docs/integrations.md)
# Kunci Fernet untuk URL webhook & token Graph. Buat dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=
TEAMS_NOTIFICATIONS_ENABLED=true
TEAMS_REQUEST_TIMEOUT=10
TEAMS_DAILY_SUMMARY_HOUR=8
TEAMS_MILESTONE_DUE_DAYS=3
# Tambahkan event Outlook lewat Microsoft Graph (butuh Calendars.ReadWrite).
OUTLOOK_GRAPH_ENABLED=false
